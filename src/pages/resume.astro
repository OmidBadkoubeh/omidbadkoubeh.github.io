---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { getPortfolio } from '../lib/portfolio';

const { profile, experience, projects, skills, education, metrics, summary } =
  await getPortfolio();

const pageTitle = `Résumé — ${profile.name} · ${profile.role}`;
const pageDesc = `Complete professional curriculum vitae of ${profile.name}, ${profile.role}. 7+ years building high-performance web and mobile apps.`;
---

<BaseLayout title={pageTitle} description={pageDesc}>
  <Nav />

  <main id="main" class="resume-page">
    <div class="container">
      <!-- Breadcrumbs & Quick Download Bar -->
      <header class="resume-toolbar no-print">
        <div class="toolbar-left">
          <a class="back-link" href="/" aria-label="Return to portfolio home">
            <Icon name="arrow-left" size={16} />
            <span>Portfolio</span>
          </a>
          <span class="toolbar-divider" aria-hidden="true">/</span>
          <span class="kicker">Curriculum Vitae</span>
        </div>

        <div class="toolbar-actions">
          <button
            class="btn btn-ghost toolbar-btn print-btn"
            type="button"
            data-print-trigger
            aria-label="Print résumé"
          >
            <Icon name="printer" size={16} />
            <span class="btn-text">Print</span>
          </button>

          <a
            class="btn btn-ghost toolbar-btn"
            href="/resume.md"
            download="Omid-Badkoubeh-Resume.md"
            data-astro-reload
            aria-label="Download résumé as Markdown"
          >
            <Icon name="file-text" size={16} />
            <span class="btn-text">Markdown</span>
          </a>

          <a
            class="btn btn-primary toolbar-btn download-primary"
            href={profile.resumeUrl}
            download="Omid-Badkoubeh-Resume.pdf"
            data-astro-reload
            aria-label="Download résumé as PDF"
          >
            <Icon name="download" size={16} />
            <span>Download PDF</span>
          </a>
        </div>
      </header>

      <!-- Quick Jump In-Page TOC -->
      <nav class="resume-toc no-print" aria-label="Résumé sections">
        <a href="#summary" class="toc-pill">Summary</a>
        <a href="#highlights" class="toc-pill">Highlights</a>
        <a href="#experience" class="toc-pill">Experience</a>
        <a href="#skills" class="toc-pill">Skills</a>
        {projects.length > 0 && <a href="#projects" class="toc-pill">Projects</a>}
        <a href="#education" class="toc-pill">Education</a>
      </nav>

      <!-- Main Resume Document Card -->
      <article class="resume-doc card hud-corners">
        <!-- Document Header -->
        <header class="doc-header">
          <div class="header-main">
            <p class="doc-kicker mono">SENIOR FRONTEND ENGINEER // TEAM LEAD</p>
            <h1 class="doc-name gradient-text">{profile.name}</h1>
            <p class="doc-title">{profile.role}</p>

            {
              profile.available && (
                <div class="doc-status">
                  <span class="status-dot" aria-hidden="true" />
                  <span class="mono">{profile.availabilityLabel}</span>
                </div>
              )
            }
          </div>

          <aside class="header-contact">
            <ul class="contact-list">
              <li>
                <Icon name="mail" size={15} />
                <a href={`mailto:${profile.email}`}>{profile.email}</a>
              </li>
              {
                profile.location && (
                  <li>
                    <Icon name="map-pin" size={15} />
                    <span>{profile.location}</span>
                  </li>
                )
              }
              {
                profile.socials
                  .filter((s) => s.icon !== 'mail')
                  .map((s) => (
                    <li>
                      <Icon name={s.icon} size={15} />
                      <a href={s.href} target="_blank" rel="noopener noreferrer">
                        {s.label}
                      </a>
                    </li>
                  ))
              }
            </ul>
          </aside>
        </header>

        <!-- Highlights / Impact Metrics -->
        {
          metrics.length > 0 && (
            <section class="doc-section page-break-avoid" id="highlights">
              <h2 class="section-title">
                <span class="title-kicker mono">01</span>
                Key Impact Highlights
              </h2>
              <div class="metrics-grid">
                {metrics.map((m) => (
                  <div class="metric-card">
                    <span class="metric-value gradient-text mono">{m.value}</span>
                    <span class="metric-label">{m.label}</span>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        <!-- Professional Summary -->
        <section class="doc-section page-break-avoid" id="summary">
          <h2 class="section-title">
            <span class="title-kicker mono">02</span>
            Professional Summary
          </h2>
          <p class="summary-text">{summary}</p>
        </section>

        <!-- Professional Experience -->
        <section class="doc-section" id="experience">
          <h2 class="section-title">
            <span class="title-kicker mono">03</span>
            Professional Experience
          </h2>

          <div class="experience-list">
            {
              experience.map((job) => (
                <article class="job-item page-break-avoid">
                  <header class="job-head">
                    <div class="job-meta-main">
                      <h3 class="job-role">{job.role}</h3>
                      <p class="job-company">
                        <span class="company-name">{job.company}</span>
                        {job.location && (
                          <span class="job-location mono">· {job.location}</span>
                        )}
                      </p>
                    </div>
                    <span class="job-period mono">{job.period}</span>
                  </header>

                  {job.stack && job.stack.length > 0 && (
                    <div class="job-stack">
                      {job.stack.map((tech) => (
                        <span class="tag">{tech}</span>
                      ))}
                    </div>
                  )}

                  <ul class="job-highlights">
                    {job.highlights.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <!-- Technical Skills -->
        <section class="doc-section page-break-avoid" id="skills">
          <h2 class="section-title">
            <span class="title-kicker mono">04</span>
            Technical Skills
          </h2>

          <div class="skills-grid">
            {
              skills.map((group) => (
                <div class="skill-category">
                  <h3 class="category-title mono">{group.title}</h3>
                  <div class="skill-chips">
                    {group.items.map((item) => (
                      <span class="tag">{item}</span>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Projects -->
        {
          projects.length > 0 && (
            <section class="doc-section page-break-avoid" id="projects">
              <h2 class="section-title">
                <span class="title-kicker mono">05</span>
                Featured Projects
              </h2>

              <div class="projects-list">
                {projects.map((proj) => (
                  <article class="project-item">
                    <header class="project-head">
                      <div class="project-heading">
                        <h3 class="project-name">{proj.name}</h3>
                        <p class="project-meta mono">
                          {proj.tagline}
                          {proj.status && (
                            <span class="status-chip">{proj.status}</span>
                          )}
                        </p>
                      </div>

                      <div class="project-actions no-print">
                        {proj.repo && (
                          <a
                            href={proj.repo}
                            class="icon-link"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`GitHub repository for ${proj.name}`}
                          >
                            <Icon name="github" size={17} />
                          </a>
                        )}
                        {proj.href && (
                          <a
                            href={proj.href}
                            class="icon-link"
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`Live demo for ${proj.name}`}
                          >
                            <Icon name="arrow-up-right" size={17} />
                          </a>
                        )}
                      </div>
                    </header>

                    {proj.tags && proj.tags.length > 0 && (
                      <div class="project-tags">
                        {proj.tags.map((t) => (
                          <span class="tag">{t}</span>
                        ))}
                      </div>
                    )}

                    <p class="project-desc">{proj.description}</p>
                  </article>
                ))}
              </div>
            </section>
          )
        }

        <!-- Education -->
        <section class="doc-section page-break-avoid" id="education">
          <h2 class="section-title">
            <span class="title-kicker mono">06</span>
            Education
          </h2>

          <div class="edu-grid">
            {
              education.map((edu) => (
                <div class="edu-card">
                  <h3 class="edu-credential">{edu.credential}</h3>
                  <p class="edu-institution mono">{edu.institution}</p>
                  <p class="edu-period mono">{edu.period}</p>
                </div>
              ))
            }
          </div>
        </section>

        <!-- Document Footer Banner -->
        <footer class="doc-footer no-print">
          <div class="doc-footer-cta">
            <p class="cta-title">Looking for a Senior Frontend Engineer?</p>
            <p class="cta-text text-muted">
              I specialize in high-performance web applications, WebGL/data viz, and design systems.
            </p>
          </div>
          <div class="doc-footer-actions">
            <a class="btn btn-primary" href={`mailto:${profile.email}`}>
              <Icon name="mail" size={16} />
              <span>Get in touch</span>
            </a>
            <a
              class="btn btn-ghost"
              href={profile.resumeUrl}
              download="Omid-Badkoubeh-Resume.pdf"
              data-astro-reload
            >
              <Icon name="download" size={16} />
              <span>Download PDF</span>
            </a>
          </div>
        </footer>
      </article>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .resume-page {
    padding-block: var(--space-xl) var(--space-4xl);
  }

  /* --- Toolbar --- */
  .resume-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-secondary);
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: rgba(148, 163, 184, 0.04);
    transition: all 180ms ease;
  }

  .back-link:hover {
    color: var(--color-fg);
    border-color: var(--color-accent);
    transform: translateX(-2px);
  }

  .toolbar-divider {
    color: var(--color-muted-fg);
    opacity: 0.4;
  }

  .toolbar-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .toolbar-btn {
    min-height: 38px;
    padding: 0.45rem 0.95rem;
    font-size: 0.85rem;
  }

  .download-primary {
    box-shadow: var(--glow-accent);
  }

  /* --- In-Page Section Pills --- */
  .resume-toc {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    overflow-x: auto;
    padding-block: 0.25rem 0.75rem;
    margin-bottom: var(--space-lg);
    scrollbar-width: none;
  }

  .resume-toc::-webkit-scrollbar {
    display: none;
  }

  .toc-pill {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-secondary);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: rgba(148, 163, 184, 0.04);
    white-space: nowrap;
    transition: all 180ms ease;
  }

  .toc-pill:hover {
    color: var(--color-fg);
    border-color: var(--color-accent-2);
    background: rgba(34, 211, 238, 0.08);
  }

  /* --- Document Container --- */
  .resume-doc {
    padding: clamp(1.5rem, 4vw, 3.5rem);
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03) 0%,
      rgba(255, 255, 255, 0) 100%
    ), var(--color-card);
  }

  /* --- Header --- */
  .doc-header {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .doc-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    color: var(--color-accent-2);
    margin-bottom: var(--space-xs);
  }

  .doc-name {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 0.35rem;
  }

  .doc-title {
    font-size: 1.25rem;
    color: var(--color-secondary);
    font-weight: 500;
  }

  .doc-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.3);
    font-size: 0.8125rem;
    color: var(--color-accent-2);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent-2);
    box-shadow: var(--glow-cyan);
    animation: blink 2s infinite ease-in-out;
  }

  .header-contact {
    display: flex;
    justify-content: flex-end;
  }

  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-secondary);
  }

  .contact-list a {
    color: var(--color-secondary);
    transition: color 180ms ease;
  }

  .contact-list a:hover {
    color: var(--color-accent-2);
  }

  /* --- Section Titles --- */
  .doc-section {
    padding-block: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .doc-section:last-of-type {
    border-bottom: none;
  }

  .section-title {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    font-size: 1.45rem;
    margin-bottom: var(--space-xl);
    letter-spacing: -0.01em;
  }

  .title-kicker {
    font-size: 0.85rem;
    color: var(--color-accent-2);
    opacity: 0.85;
  }

  /* --- Metrics Grid --- */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-md);
  }

  .metric-card {
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    background: rgba(148, 163, 184, 0.03);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .metric-value {
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .metric-label {
    font-size: 0.85rem;
    color: var(--color-secondary);
  }

  /* --- Summary --- */
  .summary-text {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--color-fg);
    max-width: 58ch;
  }

  /* --- Experience --- */
  .experience-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .job-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-bottom: var(--space-xl);
    border-bottom: 1px dashed var(--color-border);
  }

  .job-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .job-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .job-role {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-fg);
    margin-bottom: 0.2rem;
  }

  .job-company {
    font-size: 0.95rem;
    color: var(--color-accent-2);
  }

  .job-period {
    font-size: 0.85rem;
    color: var(--color-secondary);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm);
    background: rgba(148, 163, 184, 0.05);
    border: 1px solid var(--color-border);
    white-space: nowrap;
  }

  .job-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .job-highlights {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .job-highlights li {
    position: relative;
    padding-left: 1.35rem;
    font-size: 0.96rem;
    line-height: 1.6;
    color: var(--color-muted-fg);
  }

  .job-highlights li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-size: 0.9rem;
  }

  /* --- Skills Grid --- */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-lg);
  }

  .skill-category {
    padding: var(--space-md);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: rgba(148, 163, 184, 0.02);
  }

  .category-title {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-2);
    margin-bottom: var(--space-sm);
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  /* --- Projects --- */
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .project-item {
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: rgba(148, 163, 184, 0.02);
  }

  .project-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-sm);
  }

  .project-name {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .project-meta {
    font-size: 0.85rem;
    color: var(--color-secondary);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: 0.2rem;
  }

  .status-chip {
    font-size: 0.72rem;
    color: var(--color-accent-2);
    border: 1px solid rgba(34, 211, 238, 0.35);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
  }

  .project-actions {
    display: flex;
    gap: var(--space-xs);
  }

  .icon-link {
    display: inline-flex;
    padding: 0.35rem;
    border-radius: var(--radius-sm);
    color: var(--color-secondary);
    border: 1px solid var(--color-border);
    transition: all 180ms ease;
  }

  .icon-link:hover {
    color: var(--color-fg);
    border-color: var(--color-accent);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: var(--space-sm);
  }

  .project-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-muted-fg);
  }

  /* --- Education --- */
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
  }

  .edu-card {
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: rgba(148, 163, 184, 0.02);
  }

  .edu-credential {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .edu-institution {
    font-size: 0.88rem;
    color: var(--color-accent-2);
    margin-bottom: 0.25rem;
  }

  .edu-period {
    font-size: 0.82rem;
    color: var(--color-muted-fg);
  }

  /* --- Document Footer --- */
  .doc-footer {
    margin-top: var(--space-2xl);
    padding: var(--space-xl);
    border-radius: var(--radius-md);
    background: rgba(59, 130, 246, 0.04);
    border: 1px solid rgba(59, 130, 246, 0.2);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .cta-title {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .cta-text {
    font-size: 0.92rem;
  }

  .doc-footer-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  /* --- Responsive --- */
  @media (max-width: 820px) {
    .doc-header {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .header-contact {
      justify-content: flex-start;
    }

    .doc-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 640px) {
    .resume-toolbar {
      flex-direction: column;
      align-items: flex-start;
    }

    .toolbar-actions {
      width: 100%;
    }

    .toolbar-btn {
      flex: 1;
      justify-content: center;
    }

    .btn-text {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // Print trigger hook
    const printBtn = document.querySelector('[data-print-trigger]');
    if (printBtn && !printBtn.hasAttribute('data-bound')) {
      printBtn.setAttribute('data-bound', 'true');
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }
  });
</script>
