---
import { about } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section class="section" id="about">
  <div class="container">
    <SectionHeading index="01" kicker="Profile" title="About" />

    <div class="about-grid">
      <div class="about-copy reveal">
        <p class="lead">{about.headline}</p>
        {about.paragraphs.map((p) => <p class="para text-muted">{p}</p>)}
      </div>

      <aside class="about-focus card hud-corners reveal" style="--reveal-delay: 120ms">
        <p class="focus-title mono">Focus areas</p>
        <ul class="focus-list">
          {
            about.focus.map((f) => (
              <li>
                <Icon name="spark" size={16} />
                {f}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .lead {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    line-height: 1.3;
    margin-bottom: var(--space-lg);
  }

  .para + .para { margin-top: var(--space-md); }

  .about-focus { align-self: stretch; }

  .focus-title {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-2);
    margin-bottom: var(--space-md);
  }

  .focus-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .focus-list li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .focus-list :global(svg) { color: var(--color-accent); flex-shrink: 0; }

  @media (max-width: 820px) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
