---
import { profile, stats } from '../data/portfolio';
import Icon from './Icon.astro';
---

<section class="hero" id="top">
  <div class="container hero-inner">
    <p class="kicker reveal">{profile.role} · {profile.location}</p>

    <h1 class="hero-name reveal" style="--reveal-delay: 80ms">
      <span class="gradient-text">{profile.name}</span>
    </h1>

    <p class="hero-tagline reveal" style="--reveal-delay: 160ms">
      {profile.tagline}
    </p>

    {
      profile.available && (
        <p class="status reveal" style="--reveal-delay: 220ms">
          <span class="status-dot" aria-hidden="true" />
          {profile.availabilityLabel}
        </p>
      )
    }

    <div class="hero-cta reveal" style="--reveal-delay: 300ms">
      <a class="btn btn-primary" href="#work">
        View work
        <Icon name="arrow-up-right" size={16} />
      </a>
      <a class="btn btn-ghost" href="#contact">Get in touch</a>
    </div>

    <dl class="stats reveal" style="--reveal-delay: 380ms">
      {
        stats.map((s) => (
          <div class="stat">
            <dt class="stat-value gradient-text">{s.value}</dt>
            <dd class="stat-label mono">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <a class="scroll-cue" href="#about" aria-label="Scroll to about section">
    <Icon name="arrow-down" size={18} />
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - var(--nav-height));
    display: flex;
    align-items: center;
    padding-block: var(--space-3xl);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-name {
    font-size: clamp(3rem, 12vw, 7.5rem);
    line-height: 0.95;
    margin-top: var(--space-md);
  }

  .hero-tagline {
    margin-top: var(--space-lg);
    max-width: 46ch;
    font-size: clamp(1.05rem, 2.2vw, 1.4rem);
    color: var(--color-secondary);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-fg);
  }

  .status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 12px rgba(52, 211, 153, 0.7);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xl);
    margin: var(--space-3xl) 0 0;
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
    width: 100%;
  }

  .stat { display: flex; flex-direction: column; gap: 0.15rem; }
  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
  }
  .stat-label {
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted-fg);
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: var(--space-lg);
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--color-secondary);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    animation: bob 2.4s ease-in-out infinite;
  }
  .scroll-cue:hover { color: var(--color-accent-2); border-color: var(--color-accent); }

  @keyframes bob {
    0%, 100% { transform: translate(-50%, 0); }
    50% { transform: translate(-50%, 6px); }
  }

  @media (max-width: 640px) {
    .stats { gap: var(--space-xl); }
    .scroll-cue { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .status-dot, .scroll-cue { animation: none; }
  }
</style>
