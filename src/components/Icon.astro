---
// Inline SVG icons (no emoji). Brand marks use Simple Icons paths (filled);
// UI glyphs use Lucide-style stroke paths.
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;

type IconDef = { type: 'stroke' | 'fill'; body: string };

const icons: Record<string, IconDef> = {
  github: {
    type: 'fill',
