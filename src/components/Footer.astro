---
import { profile } from '../data/portfolio';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="copy mono">
      © {year} {profile.name}
    </p>
    <p class="built mono text-muted">
      Built with Astro · deployed on GitHub Pages
    </p>
    <ul class="footer-socials">
      {
        profile.socials.map((s) => (
          <li>
            <a
              href={s.href}
              aria-label={s.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={s.icon} size={18} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-xl);
    margin-top: var(--space-2xl);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .copy { font-size: 0.85rem; }
  .built { font-size: 0.78rem; }

  .footer-socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-md);
  }

  .footer-socials a { color: var(--color-secondary); transition: color 200ms ease; }
  .footer-socials a:hover { color: var(--color-accent-2); }

  @media (max-width: 640px) {
    .footer-inner { justify-content: center; text-align: center; }
    .built { order: 3; width: 100%; }
  }
</style>
